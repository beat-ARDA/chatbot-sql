{
    "domain": "Ventas AdventureWorks",
    "tables": {
        "Sales.SalesOrderHeader": {
            "alias": "ordenes, ventas",
            "role": "fact",
            "description": "Encabezado de órdenes. Usar para totales generales y métricas de clientes.",
            "columns": {
                "SalesOrderID": {
                    "synonyms": [
                        "id orden"
                    ]
                },
                "OrderDate": {
                    "synonyms": [
                        "fecha",
                        "fecha de venta"
                    ],
                    "roles": [
                        "date"
                    ]
                },
                "CustomerID": {
                    "synonyms": [
                        "id cliente",
                        "cliente"
                    ]
                },
                "TotalDue": {
                    "synonyms": [
                        "total factura"
                    ]
                }
            },
            "measures": {
                "conteo_ordenes": {
                    "expression": "COUNT(Sales.SalesOrderHeader.SalesOrderID)",
                    "synonyms": [
                        "número de pedidos",
                        "cantidad de ventas",
                        "cuántas órdenes"
                    ],
                    "description": "Cuenta el número total de transacciones realizadas."
                },
                "promedio_venta": {
                    "expression": "AVG(Sales.SalesOrderHeader.TotalDue)",
                    "synonyms": [
                        "ticket promedio",
                        "venta media"
                    ],
                    "description": "Calcula el valor promedio de las facturas."
                },
                "total_clientes_unicos": {
                    "expression": "COUNT(DISTINCT Sales.SalesOrderHeader.CustomerID)",
                    "synonyms": [
                        "cuántos clientes",
                        "base de clientes"
                    ],
                    "description": "Cuenta cuántos clientes distintos han comprado."
                }
            }
        },
        "Sales.SalesOrderDetail": {
            "alias": "detalles de orden",
            "role": "fact",
            "description": "Líneas de detalle de cada orden. Usar para desgloses por producto.",
            "columns": {
                "SalesOrderID": {
                    "synonyms": [
                        "id orden"
                    ]
                },
                "ProductID": {
                    "synonyms": [
                        "id producto"
                    ]
                },
                "OrderQty": {
                    "synonyms": [
                        "cantidad pedida",
                        "unidades"
                    ]
                },
                "LineTotal": {
                    "synonyms": [
                        "subtotal linea"
                    ]
                }
            },
            "measures": {
                "total_ventas": {
                    "expression": "SUM(Sales.SalesOrderDetail.LineTotal)",
                    "synonyms": [
                        "ventas totales",
                        "ingresos",
                        "monto vendido"
                    ],
                    "description": "Suma el total de todas las líneas de detalle."
                },
                "unidades_vendidas": {
                    "expression": "SUM(Sales.SalesOrderDetail.OrderQty)",
                    "synonyms": [
                        "volumen de ventas",
                        "total unidades"
                    ],
                    "description": "Suma la cantidad física de productos vendidos."
                }
            }
        },
        "Production.Product": {
            "alias": "productos",
            "role": "dimension",
            "description": "Catálogo de productos",
            "columns": {
                "ProductID": {
                    "synonyms": [
                        "id producto"
                    ]
                },
                "Name": {
                    "synonyms": [
                        "producto",
                        "nombre artículo"
                    ]
                },
                "ListPrice": {
                    "synonyms": [
                        "precio de lista",
                        "precio sugerido"
                    ]
                }
            },
            "measures": {
                "precio_maximo": {
                    "expression": "MAX(Production.Product.ListPrice)",
                    "synonyms": [
                        "producto más caro",
                        "precio más alto"
                    ],
                    "description": "Identifica el precio más alto en el catálogo."
                }
            }
        }
    },
    "relationships": [
        {
            "from": "Sales.SalesOrderHeader.SalesOrderID",
            "to": "Sales.SalesOrderDetail.SalesOrderID",
            "type": "one-to-many"
        },
        {
            "from": "Sales.SalesOrderDetail.ProductID",
            "to": "Production.Product.ProductID",
            "type": "many-to-one"
        }
    ]
}